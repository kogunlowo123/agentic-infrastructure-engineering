# =============================================================================
# Agentic Infrastructure Engineering — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to source control.
#
# In production, all secrets should be stored in GCP Secret Manager and
# injected via Workload Identity. This file is for local development only.

# =============================================================================
# GCP Configuration
# =============================================================================

# GCP project ID where all resources are deployed
# Required: yes
GCP_PROJECT_ID=your-gcp-project-id

# Primary GCP region for resource deployment
# Required: yes
# Default: us-central1
GCP_REGION=us-central1

# Vertex AI API endpoint location (may differ from GCP_REGION for some models)
# Required: yes
# Default: us-central1
VERTEX_AI_LOCATION=us-central1

# Vertex AI model ID for primary LLM inference (via LiteLLM)
# Required: no
# Default: gemini-1.5-pro-002
VERTEX_AI_MODEL=gemini-1.5-pro-002

# GCP Service Account JSON key path (for local dev only; use WIF in CI/prod)
# Required: no (if GOOGLE_APPLICATION_CREDENTIALS is set or ADC is configured)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# =============================================================================
# Database
# =============================================================================

# PostgreSQL connection string (with asyncpg driver for async support)
# Required: yes
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://agentic:agentic_dev_password@localhost:5432/agentic_db

# Alembic migration URL (synchronous driver; used only by Alembic)
# Required: no (derived from DATABASE_URL if not set)
# ALEMBIC_DATABASE_URL=postgresql://agentic:agentic_dev_password@localhost:5432/agentic_db

# =============================================================================
# OpenSearch
# =============================================================================

# OpenSearch cluster URL for vector search
# Required: yes
OPENSEARCH_URL=http://localhost:9200

# OpenSearch index name for Terraform documentation embeddings
# Required: no
# Default: terraform-docs
OPENSEARCH_INDEX=terraform-docs

# OpenSearch credentials (leave empty for local dev without security plugin)
# Required: no
# OPENSEARCH_USER=admin
# OPENSEARCH_PASSWORD=your-opensearch-password

# =============================================================================
# Redis
# =============================================================================

# Redis connection URL for agent state caching and distributed locks
# Required: yes
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# GitHub Integration
# =============================================================================

# GitHub Personal Access Token or GitHub App token
# Required scopes: repo (for PR creation), read:org
# Required: yes (for IaC generator PR creation and drift detector issue creation)
GITHUB_TOKEN=ghp_your_github_personal_access_token

# GitHub organization or user that owns the target infrastructure repository
# Required: yes
GITHUB_REPO_OWNER=kogunlowo123

# Target GitHub repository name for Terraform PR creation
# Required: yes
GITHUB_REPO_NAME=infrastructure

# Default base branch for pull requests
# Required: no
# Default: main
GITHUB_DEFAULT_BRANCH=main

# =============================================================================
# Authentication
# =============================================================================

# Secret key for JWT signing — must be at least 32 characters
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Required: yes
JWT_SECRET_KEY=change-me-to-a-random-32-character-or-longer-secret-key

# JWT signing algorithm
# Required: no
# Default: HS256
# Supported: HS256, HS384, HS512, RS256 (requires RSA key pair)
JWT_ALGORITHM=HS256

# JWT token expiry in minutes
# Required: no
# Default: 60
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# =============================================================================
# Observability (OpenTelemetry)
# =============================================================================

# OpenTelemetry collector OTLP endpoint (HTTP)
# Set to empty string to disable tracing
# Required: no
# Example: http://otel-collector:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# OpenTelemetry service name
# Required: no
# Default: agentic-infra-api
OTEL_SERVICE_NAME=agentic-infra-api

# =============================================================================
# IaC Security Scanning (Checkov)
# =============================================================================

# Comma-separated list of Checkov check IDs to skip globally
# Only add checks with documented, audited justification
# Required: no
# Example: CKV_GCP_62,CKV_GCP_29
CHECKOV_SKIP_CHECKS=

# Path to Checkov custom policy directory
# Required: no
# CHECKOV_EXTERNAL_CHECKS_DIR=/app/policies/checkov

# =============================================================================
# RAG Configuration
# =============================================================================

# Vertex AI embedding model for document vectorization
# Required: no
# Default: textembedding-gecko@003
RAG_EMBEDDING_MODEL=textembedding-gecko@003

# Token chunk size for document splitting
# Required: no
# Default: 1024
RAG_CHUNK_SIZE=1024

# Token overlap between adjacent chunks
# Required: no
# Default: 128
RAG_CHUNK_OVERLAP=128

# Maximum number of documents to retrieve per query
# Required: no
# Default: 5
RAG_TOP_K=5

# =============================================================================
# Cost Optimizer
# =============================================================================

# Monthly USD spend threshold for cost alerts
# Set to 0 to disable alerts
# Required: no
# Default: 1000.0
COST_ALERT_THRESHOLD_USD=1000.0

# BigQuery dataset for Cloud Billing export
# Required: yes (for cost-optimizer agent)
BILLING_BIGQUERY_DATASET=billing_export

# BigQuery table name for standard billing export
# Required: no
# Default: gcp_billing_export_v1_XXXXXX_XXXXXX_XXXXXX
BILLING_BIGQUERY_TABLE=gcp_billing_export_v1

# =============================================================================
# Alerting Integrations
# =============================================================================

# Slack webhook URL for drift and cost alerts
# Required: no
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_WORKSPACE/YOUR_CHANNEL/YOUR_TOKEN

# PagerDuty integration key for critical drift alerts
# Required: no
# PAGERDUTY_INTEGRATION_KEY=your-pagerduty-integration-key

# =============================================================================
# Application Settings
# =============================================================================

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# Required: no
# Default: INFO
LOG_LEVEL=INFO

# Deployment environment (development, staging, production)
# Required: no
# Default: development
ENVIRONMENT=development

# Maximum number of concurrent agent executions per service instance
# Required: no
# Default: 10
MAX_CONCURRENT_AGENTS=10

# Agent execution timeout in seconds
# Required: no
# Default: 300
AGENT_TIMEOUT_SECONDS=300
